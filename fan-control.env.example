# Copy to /etc/fan-control/fan-control.env and chmod 600 - it holds the iDRAC password.
IDRAC_HOST=192.168.8.120
IDRAC_USER=root
IPMI_PASSWORD=CHANGEME

# Seconds between temperature polls.
POLL_INTERVAL=10

# Ramp up at or above TEMP_HIGH, back down only below TEMP_LOW.
# Between the two the current speed is held.
TEMP_HIGH=90
TEMP_LOW=60
DUTY_HIGH=20
DUTY_LOW=10

# Log loudly if temps pass this while already at DUTY_HIGH. Does not change
# fan behaviour - control stays manual - it just flags it in the journal.
TEMP_ALARM=95

# Consecutive failed reads before assuming the worst and forcing DUTY_HIGH.
# Control stays manual; we just stop trusting the last known temperature.
FAIL_LIMIT=3

# Re-issue manual mode + duty every N cycles (30 = every 5 min at a 10s poll).
# 0 disables.
REASSERT_CYCLES=30

# Watch Dell's third-party PCIe cooling response and switch it back off if it
# returns. While it is active the BMC pins the fans to a high floor and ignores
# every duty cycle we set, so this is what keeps manual control working at all.
MANAGE_PCIE_OVERRIDE=1

# Log a "still alive" line every N cycles (360 = hourly). 0 disables.
HEARTBEAT_CYCLES=360

# Hand the fans back to iDRAC automatic control when the service stops.
# Leave at 0 to keep manual control at all times.
RESTORE_ON_EXIT=0
